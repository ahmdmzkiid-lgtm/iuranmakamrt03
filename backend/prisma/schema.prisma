generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String?  @unique
  nomorKK   String?  @unique
  nik       String?
  password  String
  nama      String
  role      String   // admin | warga
  warga     Warga?
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  createdAt DateTime @default(now())
}

model Warga {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  makamId   Int?
  makam     Makam?   @relation(fields: [makamId], references: [id])
  alamat        String?
  telepon       String?
  jumlahOrang   Int      @default(1)  // Total orang (KK + anggota) untuk iuran makam
  bulanMakamTerbayar Int @default(0)  // Progress iuran makam (0-35)
  anggotaKeluarga Json?
  isFirstLogin   Boolean  @default(true)
  iuran         Iuran[]
  createdAt     DateTime @default(now())
}

model Makam {
  id        Int      @id @default(autoincrement())
  blok      String
  nomor     String
  warga     Warga[]
  createdAt DateTime @default(now())
}

model Iuran {
  id        Int      @id @default(autoincrement())
  wargaId   Int
  warga     Warga    @relation(fields: [wargaId], references: [id])
  tipe      String   @default("warga") // warga | makam
  
  // Untuk iuran WARGA (bulanan per KK)
  tahun     Int?
  bulan     Int?
  
  // Untuk iuran MAKAM (35 bulan)
  jumlahBulan Int?    // Berapa bulan yang dibayar (untuk makam)
  jumlahOrang Int?    // Berapa orang yang dibayar (untuk makam)
  
  jumlah    Decimal  @db.Decimal(10, 2)
  status    String   // pending | lunas | ditolak
  metode    String?  // Transfer BCA, Tunai, dll
  buktiBayar String?
  tanggalBayar DateTime?
  transaksiId String?   // Untuk grouping pembayaran sekaligus
  catatanAdmin String?   // Alasan penolakan atau catatan tambahan
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
